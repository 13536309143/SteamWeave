LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_key
# Set the GPT model available to your account; no automatic model substitution.
OPENAI_MODEL=your-gpt-model
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_STYLE=chat
# Responses is also supported:
# OPENAI_API_STYLE=responses
# For Chat: OPENAI_EXTRA_BODY={"reasoning_effort":"low"}
# For Responses: OPENAI_EXTRA_BODY={"reasoning":{"effort":"low"}}
